# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Secrets and environment
.env
.env.*
*.key
*.pem
secrets.json
credentials.json

# Raw model-response cache.
#
# cache/raw_calls.jsonl (REAL responses) is deliberately NOT ignored. It is the
# whole point: committing it makes every number in this repo reproducible by
# someone with no API key, via ROUTER_MODE=replay. Commit it after the paid run.
#
# cache/raw_calls.mock.jsonl (SIMULATED responses) is ignored. It regenerates
# for free from a pure hash in seconds, so committing it would add half a
# megabyte of fabricated model output to a repo whose headline risk is a
# simulated number being mistaken for a measured one.
cache/raw_calls.mock.jsonl
cache/*.tmp
cache/*.lock
cache/*.bak

# Real results are money. They are backed up deliberately, not by accident.
results.real.jsonl
results.*.bak

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
