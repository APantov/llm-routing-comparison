# Copy this file to .env and fill in the values you need.
#
#     cp .env.example .env        # macOS / Linux
#     copy .env.example .env      # Windows
#
# .env is gitignored; this template is committed. Never put a real key in this
# file - put it in .env.
#
# Everything here is OPTIONAL. Mock mode is the default and needs none of it:
# the whole pipeline runs offline, with no key, on a bare Python install.
#
# A real environment variable always beats this file, so you can override any
# line below for a single command without editing it back afterwards.


# ---------------------------------------------------------------------------
# API keys. You only need the ones your chosen ladder actually uses.
#
#   ROUTER_LADDER=claude     -> ANTHROPIC_API_KEY
#   ROUTER_LADDER=deepseek   -> DEEPSEEK_API_KEY
#   ROUTER_LADDER=wide       -> BOTH (it spans two providers)
#
# NOTE: a Claude Pro/Max subscription does NOT include API access. These are
# separate products with separate billing. Get a key from the Claude Console.
# ---------------------------------------------------------------------------

# console.anthropic.com -> API keys
ANTHROPIC_API_KEY=

# platform.deepseek.com -> API keys
DEEPSEEK_API_KEY=


# ---------------------------------------------------------------------------
# Run configuration. All optional, all have defaults, all can equally be set on
# the command line. Uncomment to make a setting sticky across runs.
# ---------------------------------------------------------------------------

# mock (default, free, fabricated) | real (costs money) | replay (free, from cache)
# ROUTER_MODE=mock

# claude (default) | deepseek | wide
# ROUTER_LADDER=claude

# Seed for the mock world. Change it to see the run-to-run variance of the mock,
# which is the honest context for reading any small accuracy gap.
# MOCK_SEED=0


# ---------------------------------------------------------------------------
# Advanced. You will not normally touch these.
# ---------------------------------------------------------------------------

# Where the response cache lives.
# ROUTER_CACHE_DIR=cache

# Set to 0 to bypass the response cache entirely. Useful only for measuring how
# many calls the harness would make without deduplication. NOTE: replay mode
# cannot work with this off, because replay is nothing but a cache read.
# ROUTER_CACHE=1

# Set to 0 to disable memoisation of grade(). Turn this off if a real model ever
# returns non-deterministic code (something that reads the clock or calls
# random()), because the memo would hide the flakiness rather than surface it.
# ROUTER_GRADE_MEMO=1

# Where RouteLLM's cached scores live.
# ROUTELLM_SCORES_PATH=cache/routellm_scores.jsonl
